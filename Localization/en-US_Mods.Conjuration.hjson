# The file name already sets the "Mods.Conjuration" prefix, so keys here start at Items/Buffs/Projectiles.
Items: {
	TomeConjureFireAtronach: {
		DisplayName: Tome: Conjure Fire Atronach
		Tooltip: Summons a Fire Atronach that walks beside you and hurls fireballs at your enemies
	}

	TomeConjureFrostAtronach: {
		DisplayName: Tome: Conjure Frost Atronach
		Tooltip:
			'''
			Summons a huge Frost Atronach that walks into melee and punches your enemies
			Its blows inflict Frostbite
			'''
	}

	TomeConjureStormAtronach: {
		DisplayName: Tome: Conjure Storm Atronach
		Tooltip:
			'''
			Summons a Storm Atronach that hovers beside you and casts Chain Lightning
			The lightning jumps to a second enemy
			'''
	}
}

Buffs: {
	FireAtronachBuff: {
		DisplayName: Fire Atronach
		Description: A Fire Atronach fights for you
	}

	FrostAtronachBuff: {
		DisplayName: Frost Atronach
		Description: A Frost Atronach fights for you
	}

	StormAtronachBuff: {
		DisplayName: Storm Atronach
		Description: A Storm Atronach fights for you
	}
}

Projectiles: {
	FireAtronachMinion.DisplayName: Fire Atronach
	FrostAtronachMinion.DisplayName: Frost Atronach
	StormAtronachMinion.DisplayName: Storm Atronach
	AtronachSlam.DisplayName: Frost Atronach
	StormBolt.DisplayName: Chain Lightning
}

NPCs: {
	Conjurer: {
		DisplayName: Conjurer
		Bestiary: A scholar of conjuration who binds spirits of fire, frost and storm. He will teach any summoner who proves themselves against Skeletron.

		Chat: {
			Locked: The old skeleton in the dungeon still stands. Come back when it falls, and I will share my tomes.
			Line0: A Fire Atronach is not a pet. Treat it with respect and it will burn your enemies for you.
			Line1: Conjuration is simple: a strong will, a clear circle, and a lot of patience.
			Line2: Mind the curtains. Nothing in my house is fireproof any more.
			Line3: The Wizard calls it showing off. I call it bringing a friend.
			Line4: Frost atronachs are slow, but nothing gets past one. Storm atronachs never stop humming.
		}

		TownNPCMood: {
			Content: My circles are drawn, my candles are lit. I am content.
			NoHome: A conjurer without a study is just a man talking to fire. Find me a house.
			FarFromHome: My notes are all the way back home. This is no place to work.
			LoveSpace: So much room! I could summon something truly large in here.
			DislikeCrowded: Too many people. One sneeze and the circle breaks.
			HateCrowded: I cannot concentrate with this crowd. Something will catch fire.
			LikeBiome: The {BiomeName} is quiet. Good for long hours of study.
			DislikeBiome: The {BiomeName} is far too damp for fire magic.
			LoveNPC: "{NPCName} understands real magic. We talk for hours."
			LikeNPC: "{NPCName} always has something that goes boom. I respect that."
			DislikeNPC: "{NPCName} keeps throwing water at my experiments."
			LikeNPC_Princess: "{NPCName} is lovely. My atronachs behave around her."
			Princess_LovesNPC: "{NPCName} lets me watch the little fire spirits dance!"
		}

		Census.SpawnCondition: Defeat the Eye of Cthulhu
	}
}
